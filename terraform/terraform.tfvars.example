# Copiá este archivo a terraform.tfvars (gitignoreado) y completá los
# valores reales. NUNCA subas terraform.tfvars a git.

# --- AWS ---
allowed_ssh_cidrs = ["TU.IP.PUBLICA.AQUI/32"]

# key_pair_name  = "sitiowebdigital-prod" # default — ver README.md "Acceso SSH"
# aws_region     = "sa-east-1"          # default, descomentar solo para cambiarlo
# instance_type  = "t3.medium"          # default
# s3_bucket_name = "sitiowebdigital-media"

# --- Cloudflare ---
# API Token: dash.cloudflare.com > My Profile > API Tokens > Create Token,
# con permisos "Account > Cloudflare Tunnel > Edit" (y "Zone > DNS > Edit"
# solo si vas a poner manage_dns = true).
cloudflare_api_token   = "pon-tu-token-aca"
cloudflare_account_id  = "pon-tu-account-id-aca"

# Dejar en false hasta confirmar que el registro wildcard no pisa otro
# proyecto en la zona compartida cloudfordeploy.com — ver cloudflare.tf.
# manage_dns        = false
# cloudflare_zone_id = "pon-el-zone-id-aca"

# --- Matafuego SaaS (puntoco2.com) ---
# Token distinto del de arriba: solo necesita Zone:DNS:Edit sobre la zona
# puntoco2.com (mismo dashboard, My Profile > API Tokens > Create Token).
puntoco2_cloudflare_api_token = "pon-el-token-de-la-zona-puntoco2-aca"
# puntoco2_cloudflare_zone_id = "533bc36802755559ec3b71367424ea48" # default
# matafuego_api_hostname      = "api.puntoco2.com"                # default
# matafuego_backend_port      = 4001                               # default
