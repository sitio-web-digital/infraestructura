{# Generado por Ansible — no editar a mano en el servidor, se pisa en cada
   corrida del playbook. Cambiá los valores en group_vars/ (o group_vars/vault.yml
   para los secretos) y volvé a correr el playbook.

   Mismo archivo que espera server/.github/workflows/deploy-backend.yml
   (ENV_FILE=/opt/sitioweb/backend.env) — con una diferencia a propósito
   respecto del servidor original: NO tiene AWS_ACCESS_KEY_ID ni
   AWS_SECRET_ACCESS_KEY. El SDK de AWS toma las credenciales del rol de la
   instancia EC2 automáticamente (ver terraform/iam.tf) — una access key
   menos para rotar o filtrar. #}
DATABASE_URL=postgres://{{ db_user }}:{{ vault_db_password }}@localhost:{{ db_host_port }}/{{ db_name }}
JWT_SECRET={{ vault_jwt_secret }}
PORT={{ backend_port }}

AWS_REGION={{ aws_region }}
S3_BUCKET_NAME={{ s3_bucket_name }}
CLOUDFRONT_DOMAIN={{ cloudfront_domain }}

# Cuenta real (producción) desde el 2026-08-10 — antes usaba una app creada
# en la sesión de un vendedor de prueba (sandbox completo con plata falsa).
# Token de esa cuenta de prueba, comentado acá solo para volver atrás rápido
# si hiciera falta (ver vault_mp_access_token_test en group_vars/vault.yml):
# MP_ACCESS_TOKEN={{ vault_mp_access_token_test }}
MP_ACCESS_TOKEN={{ vault_mp_access_token }}
# Firma secreta del webhook de la cuenta de prueba (sandbox), comentada acá
# solo para volver atrás rápido si hiciera falta (ver
# vault_mp_webhook_secret_test en group_vars/vault.yml):
# MP_WEBHOOK_SECRET={{ vault_mp_webhook_secret_test }}
MP_WEBHOOK_SECRET={{ vault_mp_webhook_secret }}
# Public Key / Client ID / Client Secret de la cuenta real — no los usa
# ningún código todavía (el flujo actual es 100% server-side vía
# preapproval + init_point, sin SDK/Bricks del lado del frontend), quedan
# guardados acá por si se necesitan a futuro.
MP_PUBLIC_KEY={{ vault_mp_public_key }}
MP_CLIENT_ID={{ vault_mp_client_id }}
MP_CLIENT_SECRET={{ vault_mp_client_secret }}
APP_URL={{ app_url }}
ROOT_DOMAIN={{ root_domain }}

MAIL_FROM={{ mail_from }}

CLOUDFLARE_API_TOKEN={{ vault_cloudflare_api_token }}
CLOUDFLARE_ZONE_ID={{ vault_cloudflare_zone_id }}
CLOUDFLARE_ACCOUNT_ID={{ vault_cloudflare_account_id }}
