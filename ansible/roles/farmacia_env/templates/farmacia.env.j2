DATABASE_URL=postgresql://{{ farmacia_db_user }}:{{ vault_farmacia_db_password }}@localhost:{{ farmacia_db_host_port }}/{{ farmacia_db_name }}?schema=public
RUNTIME_DATABASE_URL=postgresql://app_user:{{ vault_farmacia_app_user_password }}@localhost:{{ farmacia_db_host_port }}/{{ farmacia_db_name }}?schema=public
AUTH_SECRET={{ vault_farmacia_auth_secret }}
PORT={{ farmacia_backend_port }}
NODE_ENV=production
