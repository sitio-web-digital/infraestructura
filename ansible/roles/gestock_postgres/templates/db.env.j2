{# docker compose lee automáticamente un archivo ".env" en el mismo directorio
   que el docker-compose.yml — así le llegan estos valores sin escribir la
   contraseña real adentro del yml. #}
POSTGRES_USER={{ gestock_db_user }}
POSTGRES_PASSWORD={{ vault_gestock_db_password }}
POSTGRES_DB={{ gestock_db_name }}
POSTGRES_HOST_PORT={{ gestock_db_host_port }}
