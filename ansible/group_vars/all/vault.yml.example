# Copiá este archivo a group_vars/vault.yml, completá los valores reales, y
# encriptalo con:
#
#   ansible-vault encrypt group_vars/vault.yml
#
# group_vars/vault.yml (ya encriptado) SÍ se sube al repo — es justamente lo
# que hace a esto reproducible en otra máquina. Lo que nunca se sube es el
# archivo .vault_pass (la contraseña que lo abre) ni este .example con
# valores de ejemplo reemplazados por reales sin encriptar.

# --- Runner de GitHub Actions ---
# Personal Access Token (classic) con scope "admin:org" (para un runner de
# organización) — se usa una sola vez, al momento de registrar el runner,
# para pedirle a la API de GitHub un token de registro de corta duración.
# Generalo en https://github.com/settings/tokens, y una vez que el runner
# esté registrado y andando podés revocarlo (Ansible no lo vuelve a usar
# salvo que reinstales el runner desde cero).
vault_github_runner_pat: "pon-tu-PAT-aca"

# --- Postgres ---
vault_db_password: "generá-una-contraseña-fuerte-aca"

# --- Backend: JWT ---
# Generar con: openssl rand -base64 48
vault_jwt_secret: "generá-un-secret-random-fuerte-aca"

# --- Mercado Pago (server/src/utils/mercadopago.js) ---
# https://www.mercadopago.com.ar/developers/panel > Tus integraciones
# Cuenta REAL (producción) — vault_mp_access_token_test guarda el token de
# la app de sandbox (vendedor de prueba) solo para poder volver atrás rápido.
vault_mp_access_token: ""
vault_mp_access_token_test: ""
vault_mp_webhook_secret: ""
vault_mp_webhook_secret_test: ""
vault_mp_preapproval_plan_id: ""
# No usados por ningún código todavía (ver comentario en backend.env.j2) —
# guardados para un futuro flujo con SDK/Bricks del lado del frontend.
vault_mp_public_key: ""
vault_mp_client_id: ""
vault_mp_client_secret: ""

# --- Cloudflare (para automatización de DNS FUTURA del backend — no es lo
#     mismo que el token que usa terraform/ para crear los túneles, aunque
#     puede ser el mismo token si le das los dos permisos) ---
vault_cloudflare_api_token: ""
vault_cloudflare_zone_id: ""
vault_cloudflare_account_id: ""

# --- Tokens de los túneles (salen de `terraform output`, ver
#     scripts/fetch-tunnel-tokens.sh — no los escribas a mano) ---
vault_cloudflare_tunnel_token_frontend: ""
vault_cloudflare_tunnel_token_api: ""
vault_cloudflare_tunnel_token_matafuego_api: ""
vault_cloudflare_tunnel_token_campus: ""
vault_cloudflare_tunnel_token_stock: ""
vault_cloudflare_tunnel_token_farmacia: ""

# --- Matafuego SaaS (puntoco2.com) ---
# Contraseña del rol admin/migrate de Postgres (POSTGRES_PASSWORD del
# contenedor matafuego-db, y lo que usa DATABASE_URL).
vault_matafuego_db_password: "generá-una-contraseña-fuerte-aca"
# Contraseña del rol de mínimo privilegio "app_user" (RUNTIME_DATABASE_URL) —
# ese rol NO lo crea Ansible, se crea a mano una sola vez corriendo
# `npm run db:bootstrap` contra la base nueva (ver .env.example del repo del
# backend). Fijá acá la contraseña que le vas a poner en ese paso.
vault_matafuego_app_user_password: "generá-una-contraseña-fuerte-aca"
# Secret de sesión (AUTH_SECRET). Generar con: openssl rand -base64 32
vault_matafuego_auth_secret: "generá-un-secret-random-fuerte-aca"

# --- Campus C4D (campus.cloudfordeploy.com) ---
# Solo importan en el PRIMER arranque (cuando data/ todavía no tiene ningún
# admin creado) — ver README del repo campus. Arranques siguientes los
# ignoran, aunque no hace daño dejarlos cargados acá.
vault_campus_admin_email: "admin@cloudfordeploy.com"
vault_campus_admin_password: "generá-una-contraseña-fuerte-aca"

# --- Gestock (stock.cloudfordeploy.com) ---
# Contraseña del rol de Postgres propio (POSTGRES_PASSWORD del contenedor
# gestock-db, y lo que usa DATABASE_URL).
vault_gestock_db_password: "generá-una-contraseña-fuerte-aca"
# Generar con: openssl rand -base64 48
vault_gestock_jwt_secret: "generá-un-secret-random-fuerte-aca"
# Solo importan la primera vez que corre `npm run migrate` contra la base
# (cuando todavía no existe ningún usuario con rol superadmin) — ver
# server/src/migrate.ts del repo gestock-app. Corridas siguientes los ignoran.
vault_gestock_superadmin_email: "admin@sitioweb.digital"
vault_gestock_superadmin_password: "generá-una-contraseña-fuerte-aca"

# --- Farmacias del Sur (farmaciasdelsur.sitioweb.digital) ---
# Contraseña del rol admin de Postgres (POSTGRES_PASSWORD del contenedor
# farmacia-db, y lo que usa DATABASE_URL).
vault_farmacia_db_password: "generá-una-contraseña-fuerte-aca"
# Contraseña del rol de mínimo privilegio "app_user" (RUNTIME_DATABASE_URL) —
# ese rol lo crea la migración `app_role_and_rls`, pero la contraseña hay
# que fijársela a mano una vez (ALTER ROLE app_user WITH PASSWORD ...)
# contra la base ya migrada, igual que con Matafuego.
vault_farmacia_app_user_password: "generá-una-contraseña-fuerte-aca"
# Generar con: openssl rand -base64 32 (mínimo 32 caracteres, lo valida
# src/server/env.ts del repo)
vault_farmacia_auth_secret: "generá-un-secret-random-fuerte-aca"
